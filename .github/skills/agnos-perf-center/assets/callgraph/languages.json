{
  "_comment": "agnos-perf-center call graph languages (RQ-TRC-032, DEC-TRC-014): extensions, grammar wheel and module, query file, scope separator. An extension belongs to one language.",
  "_scopes": "scopes (RQ-TRC-047, DEC-TRC-019): the box kind, namespace or class, of each scope node type of the grammar; a language without scopes gives functions without box.",
  "_receivers": "self, super (RQ-TRC-124, DEC-TRC-070): the receiver words naming the caller's own object and its parent object; a call through them is looked for in the caller's class and its ancestors, or its ancestors only.",
  "_constructor": "constructor (RQ-TRC-125, DEC-TRC-070): the name of a class's constructor where it is not the class's own name; a creation, or a call to a class's name, links to the class's functions of either name.",
  "_arity": "arity (RQ-TRC-127, DEC-TRC-070, DEC-TRC-073): the node types counted as parameters; a variadic node or token makes the count unbounded; a parameter holding a default token is optional; a first parameter written as a receiver word, or a parameter written as a none word (void), is not counted; a spread argument makes the call's count unknown.",
  "c": {
    "arity": {"parameters": ["parameter_declaration"], "variadic": ["variadic_parameter"], "none": ["void"]},
    "extensions": [".c"],
    "package": "tree-sitter-c",
    "module": "tree_sitter_c",
    "query": "c.scm",
    "separator": "::",
    "scopes": {}
  },
  "cpp": {
    "arity": {"parameters": ["parameter_declaration", "optional_parameter_declaration", "variadic_parameter_declaration"], "variadic": ["variadic_parameter", "variadic_parameter_declaration", "..."], "default": ["="], "none": ["void"]},
    "self": ["this"],
    "extensions": [".cc", ".cpp", ".cxx", ".c++", ".h", ".hh", ".hpp", ".hxx", ".h++", ".inl", ".ipp", ".tpp"],
    "package": "tree-sitter-cpp",
    "module": "tree_sitter_cpp",
    "query": "cpp.scm",
    "separator": "::",
    "scopes": {
      "namespace_definition": "namespace",
      "class_specifier": "class",
      "struct_specifier": "class",
      "union_specifier": "class"
    }
  },
  "csharp": {
    "arity": {"parameters": ["parameter"], "variadic": ["params"], "default": ["="]},
    "self": ["this"], "super": ["base"],
    "extensions": [".cs"],
    "package": "tree-sitter-c-sharp",
    "module": "tree_sitter_c_sharp",
    "query": "csharp.scm",
    "separator": ".",
    "scopes": {
      "namespace_declaration": "namespace",
      "compilation_unit": "namespace",
      "class_declaration": "class",
      "struct_declaration": "class",
      "interface_declaration": "class",
      "record_declaration": "class"
    }
  },
  "java": {
    "arity": {"parameters": ["formal_parameter"], "variadic": ["spread_parameter"]},
    "self": ["this"], "super": ["super"],
    "extensions": [".java"],
    "package": "tree-sitter-java",
    "module": "tree_sitter_java",
    "query": "java.scm",
    "separator": ".",
    "scopes": {
      "program": "namespace",
      "class_declaration": "class",
      "interface_declaration": "class",
      "enum_declaration": "class",
      "record_declaration": "class"
    }
  },
  "javascript": {
    "arity": {"parameters": ["identifier", "assignment_pattern", "object_pattern", "array_pattern"], "variadic": ["rest_pattern"], "default": ["="], "spread": ["spread_element"]},
    "self": ["this"], "super": ["super"], "constructor": "constructor",
    "extensions": [".js", ".jsx", ".mjs", ".cjs"],
    "package": "tree-sitter-javascript",
    "module": "tree_sitter_javascript",
    "query": "javascript.scm",
    "separator": ".",
    "scopes": {
      "class_declaration": "class"
    }
  },
  "python": {
    "arity": {"parameters": ["identifier", "typed_parameter", "default_parameter", "typed_default_parameter"], "variadic": ["list_splat_pattern", "dictionary_splat_pattern"], "default": ["="], "receiver": ["self", "cls"], "spread": ["list_splat", "dictionary_splat"]},
    "self": ["self", "cls"], "super": ["super()"], "constructor": "__init__",
    "extensions": [".py", ".pyw"],
    "package": "tree-sitter-python",
    "module": "tree_sitter_python",
    "query": "python.scm",
    "separator": ".",
